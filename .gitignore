*~
*.csv
results/*
# Virtual environment
.venv/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo

# Build artifacts
dist/
build/
*.egg-info/

# Logs
*.log

# Input/Output data (explicitly ignore, as requested for 'input' in the script logic)
input/
output/

# Misc
.DS_Store

# Pre-commit cache
.pre-commit-cache

analysis/kingdom_survey/tables/*.csv
analysis/kingdom_survey/figures/*.png
analysis/kingdom_survey/figures/*.svg
!analysis/kingdom_survey/tables/.gitkeep
!analysis/kingdom_survey/figures/.gitkeep

analysis/adhesion_properties/tables/*.csv
analysis/adhesion_properties/figures/*.png
analysis/adhesion_properties/figures/*.svg
!analysis/adhesion_properties/tables/.gitkeep
!analysis/adhesion_properties/figures/.gitkeep
