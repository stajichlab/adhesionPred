analysis/cocci_repeats/sowgp_anchor_hits.tsv
analysis/cocci_repeats/rs.dmnd

# 15 MB, 644k rows. Regenerable by 37_unit_search.sh (SLURM search). Kept local on purpose, not on GitHub.
analysis/cocci_repeats/unit_architecture_onygenales.tsv.gz

# Scratch and regenerable downloads (issue #26). Tracked files in these folders stay tracked.
validate/
query/
stage/ncbi_dataset/
stage/FLO11_*
stage/scer_proteins.faa*
