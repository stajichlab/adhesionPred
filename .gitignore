analysis/cocci_repeats/pfam_sets.fa
analysis/cocci_repeats/unit_genomes.tsv
analysis/cocci_repeats/unit_architecture_onygenales.tsv

# cocci_repeats: plain copies of outputs that are tracked as .gz (README section 6).
